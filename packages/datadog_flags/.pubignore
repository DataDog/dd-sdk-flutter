# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Repository-only precomputed conformance assets. The flag-selection fixtures stay published with their tests.
test/fixtures/.gitignore
test/fixtures/precomputed/
test/fixtures/precomputed_text.dart
test/fixtures/.precompute-*/
test/precomputed_fixture_files_test.dart
