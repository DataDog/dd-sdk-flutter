{
  "title": "MobileText",
  "type": "object",
  "required": ["type", "version", "truncation_mode", "platform"],
  "properties": {
    "type": { "type": "string", "const": "text", "description": "The kind of element." },
    "version": { "type": "integer", "const": 0 },
    "truncation_mode": {
      "type": "string",
      "enum": ["clip", "head", "tail", "middle"],
      "description": "How text is truncated."
    },
    "platform": { "$ref": "platform-schema.json" },
    "fallback_platform": { "$ref": "platform-schema.json" },
    "alignments": {
      "type": "array",
      "items": { "type": "string", "enum": ["left", "right"] }
    }
  }
}
