platform :ios, '15.0'

flutter_application_path = '../flutter_module'
load File.join(flutter_application_path, '.ios', 'Flutter', 'podhelper.rb')

target 'HybridSessionReplayExample' do
  use_frameworks!

  install_all_flutter_pods(flutter_application_path)

  # Hybrid Session Replay needs dd-sdk-ios 3.16.0 or later. Use the same version
  # datadog_flutter_plugin pins, so the native and Flutter SDKs match.
  pod 'DatadogCore', '3.16.0'
  pod 'DatadogRUM', '3.16.0'
  pod 'DatadogLogs', '3.16.0'
  pod 'DatadogSessionReplay', '3.16.0'
end

post_install do |installer|
  flutter_post_install(installer) if defined?(flutter_post_install)
end
